    {
      "tag": "black and white",
      "yes": [
        "a black and white photo.",
        "a monochrome photo."
      ],
      "no": [
        "a color photo.",
        "a colorful photo."
      ],
      "threshold": 0.8
    },
    {
      "tag": "night",

{
  "_comment": "Smart tag vocabulary. Each group is scored with a softmax over its labels, so labels in a group are alternatives. 'prompts' are averaged (prompt ensembling); {} in a template is replaced by the label's 'text'. Labels whose tag is null are distractors that are never stored. After editing, rebuild src/main/tagging/clip-labels.json with scripts/build-clip-labels.py. Attributes are yes/no pairs; when 'suppresses' fires, those groups are dropped (a document has no place).",
  "templates": {
    "subject": [
      "a photo of {}.",
      "a close-up photo of {}.",
      "a photo with {} in it.",
      "a picture of {}."
    ],
    "scene": [
      "a photo of {}.",
      "a photo taken at {}.",
      "a landscape photo of {}.",
      "a picture of {}."
    ],
    "event": [
      "a photo of {}.",
      "a photo taken at {}.",
      "a picture from {}."
    ]
  },
  "groups": [
